
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main()
{
    int shmid;
    char *shared_memory;

    // Create shared memory
    shmid = shmget(IPC_PRIVATE, 1024,
                   IPC_CREAT | 0666);

    if(shmid == -1)
    {
        perror("shmget");
        exit(1);
    }

    // Attach shared memory
    shared_memory = (char *)shmat(shmid, NULL, 0);

    if(shared_memory == (char *)-1)
    {
        perror("shmat");
        exit(1);
    }

    if(fork() == 0)
    {
        // Child process (Reader)
        wait(NULL);
        printf("Child Process: Reading message\n");
        printf("Message: %s\n", shared_memory);

        shmdt(shared_memory);
        exit(0);
    }
    else
    {
        // Parent process (Writer)
        strcpy(shared_memory,
               "Hello! Shared Memory IPC");

        printf("Parent Process: Writing message\n");

        wait(NULL);

        // Detach and remove shared memory
        shmdt(shared_memory);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}

