#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
#include <string.h>

int main()
{
    int fd;
    struct stat file_info;
    DIR *dir;
    struct dirent *entry;

    // Create and open a file
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if(fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    // Write data
    write(fd, "Hello UNIX System Calls", 23);
    printf("Data written successfully\n");

    // fcntl system call
    int flags = fcntl(fd, F_GETFL);
    printf("File flags: %d\n", flags);

    // lseek system call
    lseek(fd, 0, SEEK_SET);
    printf("File pointer moved to beginning\n");

    // stat system call
    if(stat("sample.txt", &file_info) == 0)
    {
        printf("File Size: %ld bytes\n",
               (long)file_info.st_size);
        printf("File Permissions: %o\n",
               file_info.st_mode & 0777);
    }

    close(fd);

    // opendir system call
    dir = opendir(".");

    if(dir == NULL)
    {
        perror("Directory opening failed");
        return 1;
    }

    printf("\nFiles in current directory:\n");

    // readdir system call
    while((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
