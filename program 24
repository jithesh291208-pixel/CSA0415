#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char write_data[] = "Hello, UNIX System Calls!";
    char read_data[100];

    // Create and open a file
    fd = open("sample.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);

    if(fd < 0)
    {
        printf("File creation failed\n");
        return 1;
    }

    printf("File opened successfully\n");

    // Write data into file
    write(fd, write_data, strlen(write_data));

    printf("Data written successfully\n");

    close(fd);

    // Open file for reading
    fd = open("sample.txt", O_RDONLY);

    if(fd < 0)
    {
        printf("File opening failed\n");
        return 1;
    }

    // Read data from file
    int n = read(fd, read_data, sizeof(read_data) - 1);

    if(n < 0)
    {
        printf("File reading failed\n");
        close(fd);
        return 1;
    }

    read_data[n] = '\0';

    printf("Data read from file: %s\n", read_data);

    // Close file
    close(fd);

    printf("File closed successfully\n");

    return 0;
}
