#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[50];
    char pattern[50];
    char line[200];
    int count = 0;

    printf("Enter file name: ");
    scanf("%49s", filename);

    printf("Enter word to search: ");
    scanf("%49s", pattern);

    fp = fopen(filename, "r");

    if(fp == NULL)
    {
        printf("File not found!\n");
        return 1;
    }

    printf("\nMatching lines:\n");

    while(fgets(line, sizeof(line), fp) != NULL)
    {
        if(strstr(line, pattern) != NULL)
        {
            printf("%s", line);
            count++;
        }
    }

    if(count == 0)
        printf("Pattern not found!\n");

    printf("\nTotal matching lines: %d\n", count);

    fclose(fp);

    return 0;
}
