
#include <stdio.h>
#include <string.h>

struct directory
{
    char username[30];
    char files[20][30];
    int count;
};

int main()
{
    struct directory user[10];
    char uname[30], fname[30];
    int n = 0, choice, i, j, found;

    while(1)
    {
        printf("\n\n--- Two Level Directory ---");
        printf("\n1. Create User Directory");
        printf("\n2. Create File");
        printf("\n3. Search File");
        printf("\n4. Delete File");
        printf("\n5. Display Files");
        printf("\n6. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter username: ");
                scanf("%29s", uname);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(user[i].username, uname) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("User already exists.");
                else if(n < 10)
                {
                    strcpy(user[n].username, uname);
                    user[n].count = 0;
                    n++;
                    printf("User directory created successfully.");
                }
                else
                    printf("Maximum users reached.");

                break;

            case 2:
                printf("Enter username: ");
                scanf("%29s", uname);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(user[i].username, uname) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(!found)
                {
                    printf("User directory not found.");
                    break;
                }

                printf("Enter filename: ");
                scanf("%29s", fname);

                for(j = 0; j < user[i].count; j++)
                {
                    if(strcmp(user[i].files[j], fname) == 0)
                        break;
                }

                if(j < user[i].count)
                    printf("File already exists.");
                else if(user[i].count < 20)
                {
                    strcpy(user[i].files[user[i].count], fname);
                    user[i].count++;
                    printf("File created successfully.");
                }
                else
                    printf("Directory is full.");

                break;

            case 3:
                printf("Enter username: ");
                scanf("%29s", uname);

                printf("Enter filename: ");
                scanf("%29s", fname);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(user[i].username, uname) == 0)
                    {
                        for(j = 0; j < user[i].count; j++)
                        {
                            if(strcmp(user[i].files[j], fname) == 0)
                            {
                                found = 1;
                                break;
                            }
                        }
                        break;
                    }
                }

                if(found)
                    printf("File found.");
                else
                    printf("File not found.");

                break;

            case 4:
                printf("Enter username: ");
                scanf("%29s", uname);

                printf("Enter filename: ");
                scanf("%29s", fname);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(user[i].username, uname) == 0)
                    {
                        for(j = 0; j < user[i].count; j++)
                        {
                            if(strcmp(user[i].files[j], fname) == 0)
                            {
                                found = 1;

                                for(int k = j; k < user[i].count - 1; k++)
                                    strcpy(user[i].files[k],
                                           user[i].files[k + 1]);

                                user[i].count--;
                                printf("File deleted successfully.");
                                break;
                            }
                        }
                        break;
                    }
                }

                if(!found)
                    printf("File not found.");

                break;

            case 5:
                for(i = 0; i < n; i++)
                {
                    printf("\nUser: %s\n", user[i].username);

                    if(user[i].count == 0)
                        printf("No files available.\n");

                    for(j = 0; j < user[i].count; j++)
                        printf("%s\n", user[i].files[j]);
                }

                break;

            case 6:
                printf("Exiting program.");
                return 0;

            default:
                printf("Invalid choice.");
        }
    }

    return 0;
}

