
#include <stdio.h>

int main()
{
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pr[20];
    int wt[20], tat[20];
    int highest, min_priority;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter arrival time of P%d: ", i + 1);
        scanf("%d", &at[i]);

        printf("Enter burst time of P%d: ", i + 1);
        scanf("%d", &bt[i]);

        printf("Enter priority of P%d: ", i + 1);
        scanf("%d", &pr[i]);

        rt[i] = bt[i];
    }

    while(completed < n)
    {
        highest = -1;
        min_priority = 9999;

        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && rt[i] > 0)
            {
                if(pr[i] < min_priority)
                {
                    min_priority = pr[i];
                    highest = i;
                }
            }
        }

        if(highest == -1)
        {
            time++;
            continue;
        }

        rt[highest]--;
        time++;

        if(rt[highest] == 0)
        {
            completed++;

            tat[highest] = time - at[highest];
            wt[highest] = tat[highest] - bt[highest];
        }
    }

    printf("\nProcess\tArrival\tBurst\tPriority\tWaiting\tTurnaround\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i],
               wt[i], tat[i]);

        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}

