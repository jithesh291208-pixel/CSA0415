
#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][30], name[30];
    int n = 0, choice, i, found;

    while(1)
    {
        printf("\n\n--- Single Level Directory ---");
        printf("\n1. Create File");
        printf("\n2. Search File");
        printf("\n3. Delete File");
        printf("\n4. Display Files");
        printf("\n5. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter file name: ");
                scanf("%29s", name);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("File already exists.");
                else if(n < 20)
                {
                    strcpy(files[n], name);
                    n++;
                    printf("File created successfully.");
                }
                else
                    printf("Directory is full.");

                break;

            case 2:
                printf("Enter file name to search: ");
                scanf("%29s", name);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("File found.");
                else
                    printf("File not found.");

                break;

            case 3:
                printf("Enter file name to delete: ");
                scanf("%29s", name);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;

                        for(int j = i; j < n - 1; j++)
                            strcpy(files[j], files[j + 1]);

                        n--;
                        printf("File deleted successfully.");
                        break;
                    }
                }

                if(!found)
                    printf("File not found.");

                break;

            case 4:
                printf("\nFiles in Directory:\n");

                if(n == 0)
                    printf("Directory is empty.");
                else
                {
                    for(i = 0; i < n; i++)
                        printf("%s\n", files[i]);
                }

                break;

            case 5:
                printf("Exiting program.");
                return 0;

            default:
                printf("Invalid choice.");
        }
    }

    return 0;
}

